[Unit]
Description=Codex Remote web frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# 这是需要按实际安装位置修改的模板。建议使用专用的非 root 账户。
User=codex-remote
Group=codex-remote
WorkingDirectory=/opt/codex-remote
Environment=HOME=/var/lib/codex-remote
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
EnvironmentFile=/etc/codex-remote.env
ExecStart=/usr/bin/node /opt/codex-remote/src/server/main.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

[Install]
WantedBy=multi-user.target
