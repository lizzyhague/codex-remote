[Unit]
Description=Shared upload service for AI Remote backends
After=local-fs.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
Environment=HOME=__RUN_HOME__
Environment=PATH=__RUNTIME_PATH__
Environment=NODE_ENV=production
EnvironmentFile=-__UPLOAD_ENV_FILE__
ExecStart=__NODE_BIN__ __APP_DIR__/src/shared-upload/main.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

[Install]
WantedBy=multi-user.target
