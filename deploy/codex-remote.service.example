[Unit]
Description=Codex Remote web frontend
Wants=network-online.target ai-remote-upload.service
After=network-online.target ai-remote-upload.service

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
Environment=HOME=__RUN_HOME__
Environment=PATH=__RUNTIME_PATH__
Environment=NODE_ENV=production
EnvironmentFile=__ENV_FILE__
ExecStart=__NODE_BIN__ __APP_DIR__/src/server/main.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

[Install]
WantedBy=multi-user.target
