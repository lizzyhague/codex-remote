# 建议使用 `openssl rand -hex 32` 生成，不要把真实值提交到仓库。
CODEX_REMOTE_TOKEN=replace-with-a-long-random-token
# Node 只监听回环地址；HTTPS 入口端口在反向代理中单独配置。
CODEX_REMOTE_PORT=3000
# 正常保留 Host/X-Forwarded-Host 的反向代理不需要设置。多个 Origin 用逗号分隔。
# CODEX_REMOTE_ALLOWED_ORIGINS=https://codex.example.com
CODEX_REMOTE_PROJECTS_CONFIG=/absolute/path/to/codex-remote/config/projects.json

# 可选。留空时写入运行用户 HOME 下的 ~/.local/state/codex-remote/。
# CODEX_REMOTE_STATE_FILE=/absolute/path/to/codex-remote-state/trash.json
# CODEX_REMOTE_WORK_STATE_FILE=/absolute/path/to/codex-remote-state/work.sqlite
# 必须与 ai-remote-upload.service 使用同一路径；留空时按运行用户 HOME 推导。
# AI_REMOTE_UPLOAD_SOCKET=/absolute/path/to/ai-remote/upload.sock
# 本模板针对约 4 GiB、2 核主机的保守初始值；部署后按实测资源调整。
CODEX_REMOTE_MAX_WORKERS=2
CODEX_REMOTE_MIN_AVAILABLE_MEMORY_MIB=1024
CODEX_REMOTE_OFFLINE_GRACE_MS=10000
CODEX_BIN=/absolute/path/to/codex
