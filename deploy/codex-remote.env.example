# 建议使用 `openssl rand -hex 32` 生成，不要把真实值提交到仓库。
CODEX_REMOTE_TOKEN=replace-with-a-long-random-token
CODEX_REMOTE_PORT=8787
# 正常保留 Host/X-Forwarded-Host 的反向代理不需要设置。多个 Origin 用逗号分隔。
# CODEX_REMOTE_ALLOWED_ORIGINS=https://codex.example.com
CODEX_REMOTE_PROJECTS_CONFIG=/etc/codex-remote-projects.json
CODEX_REMOTE_STATE_FILE=/var/lib/codex-remote/trash.json
CODEX_BIN=/usr/local/bin/codex
