# Generate this with `openssl rand -hex 32`; do not commit the real value.
CODEX_REMOTE_TOKEN=replace-with-a-long-random-token
# Node listens only on loopback; configure the HTTPS entry port separately in the reverse proxy.
CODEX_REMOTE_PORT=3000
# A reverse proxy that preserves Host/X-Forwarded-Host needs no setting. Separate multiple origins with commas.
# CODEX_REMOTE_ALLOWED_ORIGINS=https://codex.example.com
CODEX_REMOTE_PROJECTS_CONFIG=/absolute/path/to/codex-remote/config/projects.json

# Optional. When empty, data is written to ~/.local/state/codex-remote/ under the runtime user's HOME.
# CODEX_REMOTE_STATE_FILE=/absolute/path/to/codex-remote-state/trash.json
# CODEX_REMOTE_WORK_STATE_FILE=/absolute/path/to/codex-remote-state/work.sqlite
# Must match the path used by ai-remote-upload.service; when empty, derive it from the runtime user's HOME.
# AI_REMOTE_UPLOAD_SOCKET=/absolute/path/to/ai-remote/upload.sock
# Conservative starting values for a host with about 4 GiB and 2 cores; tune them from observed usage after deployment.
CODEX_REMOTE_MAX_WORKERS=2
CODEX_REMOTE_MIN_AVAILABLE_MEMORY_MIB=1024
CODEX_REMOTE_OFFLINE_GRACE_MS=10000
CODEX_BIN=/absolute/path/to/codex
