    "smoke": "node src/app-server/smoke.ts",
    "smoke:server": "node src/server/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "^8.18.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
