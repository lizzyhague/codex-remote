{
  "name": "codex-remote",
  "version": "0.1.0",
  "description": "Single-user web interface for controlling Codex CLI on a remote host.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit",
